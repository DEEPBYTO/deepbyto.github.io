  <style>

    /* =========================================
       RESET
       ========================================= */

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    :root {

      --bg-primary: #000000;
      --bg-secondary: #080808;
      --bg-card: rgba(18, 18, 18, 0.86);

      --text-primary: #ffffff;
      --text-secondary: #dddddd;
      --text-muted: #999999;

      --accent: #ffffff;
      --accent-dim: rgba(255,255,255,0.08);
      --accent-glow: rgba(255,255,255,0.18);

      --border: rgba(255,255,255,0.10);
      --border-hover: rgba(255,255,255,0.45);

      --nav-bg: rgba(0,0,0,0.72);
      --nav-scrolled: rgba(0,0,0,0.96);

      --shadow: rgba(0,0,0,0.65);

      --radius: 18px;
      --radius-sm: 12px;

      --transition:
        0.35s cubic-bezier(0.25,0.46,0.45,0.94);

      --font-sans:
        'Inter',
        -apple-system,
        BlinkMacSystemFont,
        'Segoe UI',
        Roboto,
        sans-serif;

      --font-display:
        'Orbitron',
        'Inter',
        sans-serif;
    }


    /* =========================================
       LIGHT MODE
       ========================================= */

    [data-theme="light"] {

      --bg-primary: #f5f5f5;
      --bg-secondary: #eeeeee;
      --bg-card: rgba(255,255,255,0.88);

      --text-primary: #111111;
      --text-secondary: #333333;
      --text-muted: #666666;

      --accent: #000000;
      --accent-dim: rgba(0,0,0,0.06);
      --accent-glow: rgba(0,0,0,0.12);

      --border: rgba(0,0,0,0.10);
      --border-hover: rgba(0,0,0,0.35);

      --nav-bg: rgba(255,255,255,0.82);
      --nav-scrolled: rgba(255,255,255,0.96);

      --shadow: rgba(0,0,0,0.15);
    }


    /* =========================================
       BASE
       ========================================= */

    html {
      scroll-behavior: smooth;
      -webkit-font-smoothing: antialiased;
    }

    body {
      font-family: var(--font-sans);
      background: var(--bg-primary);
      color: var(--text-primary);
      line-height: 1.6;
      overflow-x: hidden;

      transition:
        background 0.4s ease,
        color 0.3s ease;
    }

    ::selection {
      background: var(--accent);
      color: var(--bg-primary);
    }

    a {
      color: var(--text-primary);
      text-decoration: none;
    }

    button {
      font-family: inherit;
    }


    /* =========================================
       BACKGROUND
       ========================================= */

    .background-grid {
      position: fixed;
      inset: 0;

      pointer-events: none;
      z-index: 0;

      opacity: 0.25;

      background-image:
        linear-gradient(
          rgba(255,255,255,0.025) 1px,
          transparent 1px
        ),
        linear-gradient(
          90deg,
          rgba(255,255,255,0.025) 1px,
          transparent 1px
        );

      background-size: 60px 60px;
    }

    [data-theme="light"] .background-grid {
      opacity: 0.18;

      background-image:
        linear-gradient(
          rgba(0,0,0,0.035) 1px,
          transparent 1px
        ),
        linear-gradient(
          90deg,
          rgba(0,0,0,0.035) 1px,
          transparent 1px
        );
    }


    /* =========================================
       CONTAINER
       ========================================= */

    .container {
      width: 100%;
      max-width: 1240px;

      margin: 0 auto;

      padding-left: 24px;
      padding-right: 24px;

      position: relative;
      z-index: 2;
    }


    /* =========================================
       NAVBAR
       ========================================= */

    .navbar {
      position: fixed;

      top: 0;
      left: 0;

      width: 100%;

      z-index: 1000;

      padding: 16px 0;

      background: var(--nav-bg);

      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);

      border-bottom: 1px solid var(--border);

      transition:
        background var(--transition),
        box-shadow var(--transition);
    }

    .navbar.scrolled {
      background: var(--nav-scrolled);

      box-shadow:
        0 8px 30px var(--shadow);
    }

    .navbar .container {

      display: flex;

      align-items: center;
      justify-content: space-between;
    }


    /* BRAND */

    .nav-brand {

      font-family: var(--font-display);

      font-size: 1.15rem;

      font-weight: 800;

      letter-spacing: 0.08em;

      color: var(--text-primary);

      transition: opacity 0.3s ease;
    }

    .nav-brand:hover {
      opacity: 0.7;
    }


    /* NAV LINKS */

    .nav-links {

      display: flex;

      align-items: center;

      gap: 30px;

      list-style: none;
    }

    .nav-links a {

      position: relative;

      font-size: 0.85rem;

      font-weight: 500;

      color: var(--text-secondary);

      transition: color 0.3s ease;
    }

    .nav-links a::after {

      content: '';

      position: absolute;

      left: 0;
      bottom: -6px;

      width: 0;
      height: 2px;

      background: var(--accent);

      border-radius: 4px;

      transition: width 0.3s ease;
    }

    .nav-links a:hover,
    .nav-links a.active {
      color: var(--text-primary);
    }

    .nav-links a:hover::after,
    .nav-links a.active::after {
      width: 100%;
    }


    /* THEME */

    .theme-toggle {

      display: flex;

      align-items: center;

      gap: 7px;

      padding: 7px 13px;

      border-radius: 50px;

      background: var(--accent-dim);

      border: 1px solid var(--border);

      color: var(--text-secondary);

      cursor: pointer;

      font-size: 0.75rem;

      transition: all 0.3s ease;
    }

    .theme-toggle:hover {

      border-color: var(--accent);

      color: var(--text-primary);
    }


    /* MOBILE BUTTON */

    .nav-toggle {

      display: none;

      width: 42px;
      height: 42px;

      align-items: center;
      justify-content: center;

      flex-direction: column;

      gap: 5px;

      background: transparent;

      border: 1px solid var(--border);

      border-radius: 10px;

      cursor: pointer;
    }

    .nav-toggle span {

      width: 22px;
      height: 2px;

      background: var(--text-primary);

      border-radius: 5px;

      transition: all 0.3s ease;
    }

    .nav-toggle.active span:nth-child(1) {
      transform:
        rotate(45deg)
        translate(5px, 5px);
    }

    .nav-toggle.active span:nth-child(2) {
      opacity: 0;
    }

    .nav-toggle.active span:nth-child(3) {
      transform:
        rotate(-45deg)
        translate(5px, -5px);
    }


    /* =========================================
       HERO
       ========================================= */

    .hero {

      position: relative;

      min-height: 62vh;

      display: flex;

      align-items: center;

      text-align: center;

      padding: 150px 0 90px;

      overflow: hidden;
    }

    .hero::before {

      content: '';

      position: absolute;

      width: 600px;
      height: 600px;

      left: 50%;
      top: 10%;

      transform: translateX(-50%);

      background:
        radial-gradient(
          circle,
          rgba(255,255,255,0.08),
          transparent 65%
        );

      filter: blur(20px);

      pointer-events: none;
    }

    [data-theme="light"] .hero::before {

      background:
        radial-gradient(
          circle,
          rgba(0,0,0,0.06),
          transparent 65%
        );
    }

    .hero-content {

      max-width: 850px;

      margin: auto;

      position: relative;
      z-index: 2;
    }

    .hero-label {

      display: inline-flex;

      align-items: center;

      gap: 8px;

      padding: 7px 16px;

      border-radius: 50px;

      background: var(--accent-dim);

      border: 1px solid var(--border);

      font-size: 0.7rem;

      font-weight: 600;

      letter-spacing: 0.14em;

      text-transform: uppercase;

      margin-bottom: 24px;
    }

    .hero-dot {

      width: 6px;
      height: 6px;

      border-radius: 50%;

      background: var(--accent);

      animation: pulse 2s infinite;
    }

    @keyframes pulse {

      0%,100% {
        opacity: 1;
        transform: scale(1);
      }

      50% {
        opacity: 0.35;
        transform: scale(0.75);
      }
    }

    .hero h1 {

      font-family: var(--font-display);

      font-size:
        clamp(
          2.7rem,
          7vw,
          5.5rem
        );

      line-height: 1.05;

      font-weight: 800;

      letter-spacing: -0.035em;

      margin-bottom: 22px;
    }

    .hero h1 span {
      opacity: 0.55;
    }

    .hero-description {

      max-width: 650px;

      margin: auto;

      color: var(--text-secondary);

      font-size: 1.05rem;

      line-height: 1.8;
    }


    /* =========================================
       DEMOS SECTION
       ========================================= */

    .demos-section {

      padding: 30px 0 110px;

      position: relative;
      z-index: 2;
    }

    .section-heading {

      text-align: center;

      margin-bottom: 48px;
    }

    .section-heading .label {

      display: inline-block;

      padding: 5px 14px;

      border-radius: 50px;

      background: var(--accent-dim);

      border: 1px solid var(--border);

      font-family: var(--font-display);

      font-size: 0.68rem;

      font-weight: 600;

      letter-spacing: 0.15em;

      text-transform: uppercase;

      margin-bottom: 14px;
    }

    .section-heading h2 {

      font-family: var(--font-display);

      font-size:
        clamp(
          1.9rem,
          4vw,
          3rem
        );

      line-height: 1.15;

      margin-bottom: 12px;
    }

    .section-heading p {

      max-width: 650px;

      margin: auto;

      color: var(--text-secondary);

      font-size: 0.95rem;
    }


    /* =========================================
       DEMOS GRID
       ========================================= */

    .demos-grid {

      display: grid;

      grid-template-columns:
        repeat(
          2,
          minmax(0, 1fr)
        );

      gap: 28px;
    }


    /* =========================================
       DEMO CARD
       ========================================= */

    .demo-card {

      background: var(--bg-card);

      border: 1px solid var(--border);

      border-radius: var(--radius);

      overflow: hidden;

      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);

      box-shadow:
        0 15px 45px var(--shadow);

      transition:
        transform 0.45s ease,
        border-color 0.45s ease,
        box-shadow 0.45s ease;

      opacity: 0;
      transform: translateY(35px);

      animation: cardReveal 0.7s ease forwards;
    }

    .demo-card:hover {

      transform: translateY(-8px);

      border-color: var(--border-hover);

      box-shadow:
        0 28px 60px var(--shadow),
        0 0 45px var(--accent-glow);
    }

    @keyframes cardReveal {

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .demo-card:nth-child(1) {
      animation-delay: 0.05s;
    }

    .demo-card:nth-child(2) {
      animation-delay: 0.12s;
    }

    .demo-card:nth-child(3) {
      animation-delay: 0.19s;
    }

    .demo-card:nth-child(4) {
      animation-delay: 0.26s;
    }

    .demo-card:nth-child(5) {
      animation-delay: 0.33s;
    }

    .demo-card:nth-child(6) {
      animation-delay: 0.40s;
    }


    /* =========================================
       PREVIEW
       ========================================= */

    .demo-preview {

      position: relative;

      width: 100%;

      aspect-ratio: 16 / 10;

      overflow: hidden;

      background: #111;

      border-bottom: 1px solid var(--border);
    }

    .demo-preview iframe {

      position: absolute;

      top: 0;
      left: 0;

      width: 200%;
      height: 200%;

      border: 0;

      transform:
        scale(0.5);

      transform-origin: top left;

      background: #000;
    }


    /* TOP BAR */

    .preview-bar {

      position: absolute;

      top: 0;
      left: 0;

      width: 100%;

      height: 34px;

      display: flex;

      align-items: center;

      gap: 6px;

      padding: 0 12px;

      background: rgba(0,0,0,0.82);

      backdrop-filter: blur(10px);

      z-index: 5;

      border-bottom: 1px solid rgba(255,255,255,0.12);
    }

    .preview-dot {

      width: 7px;
      height: 7px;

      border-radius: 50%;

      background: rgba(255,255,255,0.65);
    }

    .preview-url {

      margin-left: 7px;

      font-size: 0.58rem;

      color: rgba(255,255,255,0.55);

      white-space: nowrap;

      overflow: hidden;

      text-overflow: ellipsis;
    }


    /* PREVIEW OVERLAY */

    .preview-overlay {

      position: absolute;

      inset: 0;

      z-index: 4;

      display: flex;

      align-items: flex-end;

      justify-content: flex-end;

      padding: 16px;

      pointer-events: none;

      background:
        linear-gradient(
          to top,
          rgba(0,0,0,0.35),
          transparent 30%
        );
    }


    /* =========================================
       CARD BODY
       ========================================= */

    .demo-body {

      padding: 24px;

      display: flex;

      flex-direction: column;

      gap: 13px;
    }

    .demo-top {

      display: flex;

      align-items: flex-start;

      justify-content: space-between;

      gap: 15px;
    }

    .demo-number {

      font-family: var(--font-display);

      font-size: 0.62rem;

      letter-spacing: 0.15em;

      color: var(--text-muted);

      margin-bottom: 5px;
    }

    .demo-title {

      font-family: var(--font-display);

      font-size: 1.2rem;

      font-weight: 700;

      line-height: 1.25;
    }

    .demo-category {

      display: inline-flex;

      align-items: center;

      padding: 5px 10px;

      border-radius: 50px;

      background: var(--accent-dim);

      border: 1px solid var(--border);

      color: var(--text-secondary);

      font-size: 0.65rem;

      font-weight: 600;

      white-space: nowrap;
    }

    .demo-description {

      color: var(--text-secondary);

      font-size: 0.84rem;

      line-height: 1.7;
    }


    /* =========================================
       BUTTONS
       ========================================= */

    .demo-actions {

      display: flex;

      gap: 10px;

      margin-top: 5px;
    }

    .demo-button {

      display: inline-flex;

      align-items: center;

      justify-content: center;

      gap: 8px;

      min-height: 42px;

      padding: 10px 18px;

      border-radius: 50px;

      font-size: 0.78rem;

      font-weight: 600;

      transition:
        all 0.3s ease;
    }

    .demo-button.primary {

      background: var(--accent);

      color: var(--bg-primary);

      flex: 1;
    }

    .demo-button.primary:hover {

      transform: translateY(-2px);

      opacity: 0.82;

      box-shadow:
        0 8px 20px var(--accent-glow);
    }

    .demo-button.secondary {

      border: 1px solid var(--border);

      color: var(--text-primary);

      background: transparent;
    }

    .demo-button.secondary:hover {

      border-color: var(--accent);

      background: var(--accent-dim);
    }


    /* =========================================
       CTA
       ========================================= */

    .bottom-cta {

      margin-top: 70px;

      padding: 55px 35px;

      text-align: center;

      background: var(--accent-dim);

      border: 1px solid var(--border);

      border-radius: var(--radius);

      backdrop-filter: blur(10px);
    }

    .bottom-cta h2 {

      font-family: var(--font-display);

      font-size:
        clamp(
          1.5rem,
          3vw,
          2.3rem
        );

      margin-bottom: 12px;
    }

    .bottom-cta p {

      max-width: 650px;

      margin: auto auto 24px;

      color: var(--text-secondary);

      font-size: 0.95rem;
    }

    .cta-button {

      display: inline-flex;

      align-items: center;

      gap: 9px;

      padding: 13px 25px;

      border-radius: 50px;

      background: var(--accent);

      color: var(--bg-primary);

      font-size: 0.85rem;

      font-weight: 600;

      transition:
        all 0.3s ease;
    }

    .cta-button:hover {

      transform: translateY(-2px);

      opacity: 0.85;

      box-shadow:
        0 12px 30px var(--accent-glow);
    }


    /* =========================================
       FOOTER
       ========================================= */

    .footer {

      padding: 45px 0 30px;

      border-top: 1px solid var(--border);

      background: var(--bg-secondary);

      position: relative;

      z-index: 2;
    }

    .footer-main {

      display: flex;

      justify-content: space-between;

      align-items: center;

      gap: 30px;

      padding-bottom: 28px;

      border-bottom: 1px solid var(--border);
    }

    .footer-brand {

      font-family: var(--font-display);

      font-weight: 800;

      font-size: 1.1rem;

      letter-spacing: 0.07em;
    }

    .footer-tagline {

      color: var(--text-muted);

      font-size: 0.75rem;

      margin-top: 4px;
    }

    .footer-links {

      display: flex;

      flex-wrap: wrap;

      gap: 20px;
    }

    .footer-links a {

      font-size: 0.75rem;

      color: var(--text-secondary);

      transition: color 0.3s ease;
    }

    .footer-links a:hover {
      color: var(--text-primary);
    }

    .footer-bottom {

      display: flex;

      align-items: center;

      justify-content: space-between;

      gap: 20px;

      padding-top: 20px;
    }

    .footer-bottom p {

      color: var(--text-muted);

      font-size: 0.7rem;
    }


    /* =========================================
       RESPONSIVE
       ========================================= */

    @media (max-width: 900px) {

      .demos-grid {
        grid-template-columns: 1fr;
      }

      .hero {
        min-height: 55vh;
      }
    }


    @media (max-width: 768px) {

      .nav-links {

        position: fixed;

        top: 0;
        right: -100%;

        width: 280px;
        height: 100vh;

        flex-direction: column;

        justify-content: center;

        gap: 28px;

        background: var(--bg-primary);

        border-left: 1px solid var(--border);

        transition: right 0.4s ease;
      }

      .nav-links.open {
        right: 0;
      }

      .nav-links a {
        font-size: 1rem;
      }

      .theme-toggle {
        margin-top: 10px;
      }

      .nav-toggle {
        display: flex;

        position: relative;

        z-index: 1001;
      }

      .hero {
        padding-top: 130px;
      }

      .hero-description {
        font-size: 0.92rem;
      }

      .footer-main {
        flex-direction: column;
        text-align: center;
      }

      .footer-bottom {
        flex-direction: column;
        text-align: center;
      }
    }


    @media (max-width: 480px) {

      .container {
        padding-left: 16px;
        padding-right: 16px;
      }

      .hero {
        min-height: 52vh;

        padding:
          120px 0
          65px;
      }

      .hero h1 {
        font-size: 2.35rem;
      }

      .hero-description {
        font-size: 0.86rem;
      }

      .demo-body {
        padding: 20px;
      }

      .demo-top {
        flex-direction: column;
        gap: 8px;
      }

      .demo-category {
        align-self: flex-start;
      }

      .demo-actions {
        flex-direction: column;
      }

      .demo-button.secondary {
        width: 100%;
      }

      .bottom-cta {
        padding:
          40px 20px;
      }
    }


    /* =========================================
       REDUCED MOTION
       ========================================= */

    @media (prefers-reduced-motion: reduce) {

      html {
        scroll-behavior: auto;
      }

      *,
      *::before,
      *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
      }
    }

  </style>
</head>


<body>

  <div class="background-grid"></div>


  <!-- =========================================
       NAVBAR
       ========================================= -->

  <nav class="navbar" id="navbar">

    <div class="container">

      <a href="https://deepbyto.github.io/"
